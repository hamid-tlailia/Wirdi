<?xml version="1.0" encoding="utf-8"?>
<!-- ثيم ليلي فاخر: نيلي عميق مع توهّج كهرماني خفيف -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient android:angle="300" android:startColor="#0F1633" android:centerColor="#1B2452" android:endColor="#2E275A" />
            <corners android:radius="30dp" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient android:type="radial" android:centerX="0.92" android:centerY="0.0"
                android:gradientRadius="70%p" android:startColor="#2EFFC46B" android:endColor="#00FFC46B" />
            <corners android:radius="30dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#00000000" />
            <corners android:radius="30dp" />
            <stroke android:width="1dp" android:color="#38FFC46B" />
        </shape>
    </item>
</layer-list>
